# Environment Configuration Template for SwasthyaSetu Monorepo

# General
ENVIRONMENT=development
LOG_LEVEL=info

# FastAPI Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=swasthya_user
POSTGRES_PASSWORD=swasthya_password
POSTGRES_DB=swasthya_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Cache / Queue Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Next.js Facility Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_secure_nextauth_secret

# Flutter Mobile Application Configuration
API_BASE_URL=http://10.0.2.2:8000
